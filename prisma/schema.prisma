generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  listings  Listing[]
  createdAt DateTime  @default(now())
}

model Listing {
  id         Int       @id @default(autoincrement())
  title      String
  price      Float?
  shopName   String?
  etsyId     String?   @unique
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime  @default(now())
}

model MyCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String   @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EtsyListing {
  id                        Int                          @id @default(autoincrement())
  // Print listing ID: Prisma keeps the legacy property name for existing callers.
  etsyId                    String?                      @unique(map: "etsy_listings_etsyId_key") @map("etsyPrintId")
  etsyDownloadId            String?                      @unique
  etsyDownloadState         String?
  etsyDownloadUrl           String?                      @db.Text
  etsyDownloadRawJson       Json?
  etsyDownloadShopSectionId Int?
  etsyDownloadLastSyncedAt  DateTime?
  shopId                    String
  userId                    String?
  title                     String
  description               String?                      @db.Text
  digitalTitle              String?                      @db.VarChar(255)
  digitalDescription        String?                      @db.Text
  digitalQuantity           Int?
  listingDescription        String?                      @db.VarChar(1000)
  listingItem               String?                      @db.VarChar(100)
  roomTheme                 String?                      @db.VarChar(200)
  personalisationHeaderText String?                      @db.VarChar(200)
  personalisationFooterText String?                      @db.VarChar(200)
  personalisationFontId     String?                      @db.VarChar(64)
  state                     String?
  url                       String?                      @db.Text
  quantity                  Int?
  priceAmount               Int?
  priceDivisor              Int?
  priceCurrencyCode         String?
  taxonomyId                Int?
  shopSectionId             Int?
  whoMade                   String?
  isSupply                  Boolean?
  whenMade                  String?
  shouldAutoRenew           Boolean?
  isPersonalizable          Boolean?
  personalizationIsRequired Boolean?
  language                  String?
  primaryColour             String?
  secondaryColour           String?
  createdTimestamp          Int?
  updatedTimestamp          Int?
  originalCreationTimestamp Int?
  endingTimestamp           Int?
  rawJson                   Json?
  subSectionId              Int?
  sourceSectionId           Int?
  localDirectoryName        String?
  thumbnailFileName         String?
  thumbnailOriginalFileName String?
  isLocal                   Boolean                      @default(false)
  downloadedAt              DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  lastLocalChangeAt         DateTime                     @default(now())
  lastSyncedAt              DateTime?
  detailsChanged            Boolean                      @default(false)
  tagsChanged               Boolean                      @default(false)
  imagesChanged             Boolean                      @default(false)
  downloadsChanged          Boolean                      @default(false)
  productsChanged           Boolean                      @default(false)
  numberOfItems             Int?                         @default(1)
  includeAllItems           Boolean                      @default(false)
  etsyProductType           String                       @default("physical") @db.VarChar(16)
  downloadsRevision         Int                          @default(0)
  zippedRevision            Int                          @default(0)
  hasEverZipped             Boolean                      @default(false)
  dropboxRevision           Int                          @default(0)
  dropboxSyncedAt           DateTime?
  tags                      EtsyListingTag[]
  materials                 EtsyListingMaterial[]
  images                    EtsyListingImage[]
  files                     EtsyListingFile[]
  zippedFiles               EtsyListingZip[]
  styles                    EtsyListingStyle[]
  videos                    EtsyListingVideo[]
  translations              EtsyListingTranslation[]
  inventoryItems            EtsyListingInventory[]
  personalizations          EtsyListingPersonalization[]
  buyerPrices               EtsyListingBuyerPrice[]
  localProfile              EtsyListingLocalProfile?
  dropboxFiles              EtsyListingDropboxFile[]
  dropboxBundle             EtsyListingDropboxBundle?
  pinterestPins             PinterestPin[]
  priceMappings             EtsyListingPriceMapping[]
  priceUpdateItems          EtsyPriceUpdateItem[]
  productConfig             EtsyListingProductConfig?
  sizeOptions               EtsyListingSizeOption[]
  frameOptions              EtsyListingFrameOption[]
  products                  EtsyListingProduct[]
  subSection                EtsyShopSubSection?          @relation(fields: [subSectionId], references: [id], onDelete: SetNull)
  sourceSection             EtsyShopSection?             @relation("ListingSourceSection", fields: [sourceSectionId], references: [id], onDelete: SetNull)

  @@unique([subSectionId, localDirectoryName])
  @@index([shopId])
  @@index([state])
  @@index([subSectionId])
  @@index([sourceSectionId])
  @@map("etsy_listings")
}

model EtsyListingProductConfig {
  id                        Int         @id @default(autoincrement())
  listingId                 Int         @unique
  listOnEtsy                Boolean     @default(true)
  digitalDownload           Boolean     @default(false)
  printsFrames              Boolean     @default(true)
  customTop                 Boolean     @default(true)
  customBottom              Boolean     @default(true)
  customiseDigitalDownloads Boolean     @default(false)
  customisePrints           Boolean     @default(true)
  downloadSectionId         Int?
  returnPolicyId            String?     @db.VarChar(64)
  sku                       String?     @db.VarChar(32)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  listing                   EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("etsy_listing_product_configs")
}

model EtsyDownloadSection {
  id                Int      @id @default(autoincrement())
  etsyShopId        BigInt
  etsyShopSectionId Int
  title             String   @db.VarChar(191)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([etsyShopId, etsyShopSectionId])
  @@index([etsyShopId])
  @@map("etsy_download_sections")
}

model EtsyListingSizeOption {
  id        Int         @id @default(autoincrement())
  listingId Int
  sizeKey   String      @db.VarChar(16)
  enabled   Boolean     @default(true)
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  listing   EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, sizeKey])
  @@index([listingId, position])
  @@map("etsy_listing_size_options")
}

model EtsyListingFrameOption {
  id        Int         @id @default(autoincrement())
  listingId Int
  frameKey  String      @db.VarChar(16)
  enabled   Boolean     @default(false)
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  listing   EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, frameKey])
  @@index([listingId, position])
  @@map("etsy_listing_frame_options")
}

model EtsyListingProduct {
  id             Int         @id @default(autoincrement())
  listingId      Int
  productKey     String      @db.VarChar(64)
  productType    String      @db.VarChar(16)
  sizeKey        String?     @db.VarChar(16)
  frameKey       String?     @db.VarChar(16)
  sku            String      @unique @db.VarChar(32)
  priceKey       String      @db.VarChar(64)
  position       Int         @default(0)
  etsyListingId  String?     @db.VarChar(64)
  etsyProductId  String?     @db.VarChar(64)
  etsyOfferingId String?     @db.VarChar(64)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  listing        EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, productKey])
  @@index([listingId, position])
  @@index([priceKey])
  @@map("etsy_listing_products")
}

model AdminProductPrice {
  id              Int      @id @default(autoincrement())
  productKey      String   @unique @db.VarChar(64)
  category        String   @db.VarChar(24)
  amountPence     Int
  currencyCode    String   @default("GBP") @db.VarChar(3)
  etsySyncPending Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@map("admin_product_prices")
}

model EtsyListingPriceMapping {
  id                 Int         @id @default(autoincrement())
  listingId          Int
  productKey         String      @db.VarChar(64)
  etsyProductId      String?     @db.VarChar(64)
  etsyOfferingId     String?     @db.VarChar(64)
  fulfilmentProvider String?     @db.VarChar(64)
  isSupported        Boolean     @default(true)
  shippingProfileId  String?     @db.VarChar(64)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  listing            EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([productKey])
  @@index([listingId])
  @@map("etsy_listing_price_mappings")
}

model EtsyPriceUpdateJob {
  id             String                @id @db.VarChar(36)
  status         String                @default("waiting") @db.VarChar(20)
  changedPrices  Json
  total          Int                   @default(0)
  processed      Int                   @default(0)
  succeeded      Int                   @default(0)
  failed         Int                   @default(0)
  skipped        Int                   @default(0)
  currentListing String?               @db.VarChar(255)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  completedAt    DateTime?
  items          EtsyPriceUpdateItem[]

  @@index([status, createdAt])
  @@map("etsy_price_update_jobs")
}

model EtsyPriceUpdateItem {
  id            Int                @id @default(autoincrement())
  jobId         String             @db.VarChar(36)
  listingId     Int
  listingName   String             @db.VarChar(255)
  etsyListingId String             @db.VarChar(64)
  priceKeys     Json
  status        String             @default("waiting") @db.VarChar(20)
  attempts      Int                @default(0)
  message       String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  job           EtsyPriceUpdateJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  listing       EtsyListing        @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([jobId, listingId])
  @@index([jobId, status])
  @@index([listingId])
  @@map("etsy_price_update_items")
}

model EtsyListingLocalProfile {
  id          Int         @id @default(autoincrement())
  listingId   Int         @unique
  name        String
  description String      @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  listing     EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("etsy_listing_local_profiles")
}

model EtsyListingDropboxFile {
  id                  Int         @id @default(autoincrement())
  listingId           Int
  sourceListingId     Int?
  sourceDirectoryName String
  groupNumber         Int
  localFileName       String
  originalFileName    String?
  sizeBytes           Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  listing             EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, groupNumber])
  @@map("etsy_listing_dropbox_files")
}

model EtsyListingDropboxBundle {
  id           Int         @id @default(autoincrement())
  listingId    Int         @unique
  folderPath   String
  sharedUrl    String?     @db.Text
  instructions String      @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  listing      EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("etsy_listing_dropbox_bundles")
}

model EtsyShop {
  id                    Int                         @id @default(autoincrement())
  etsyShopId            BigInt                      @unique
  userId                BigInt
  shopName              String?
  title                 String?
  announcement          String?                     @db.Text
  url                   String?                     @db.Text
  downloadedAt          DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  sections              EtsyShopSection[]
  financialEntries      FinancialEntry[]
  accountingReceipts    EtsyReceipt[]
  accountingTransactions EtsyTransaction[]
  accountingLedgerEntries EtsyPaymentLedgerEntry[]
  accountingSyncState   EtsyAccountingSyncState?

  @@index([userId])
  @@map("etsy_shops")
}

enum FinancialEntryType {
  INCOME
  EXPENSE
}

enum FinancialEntrySource {
  ETSY
  MANUAL
}

enum EtsyAccountingSyncStatus {
  IDLE
  RUNNING
  FAILED
}

model FinancialEntry {
  id                    Int                  @id @default(autoincrement())
  entryDate             DateTime
  type                  FinancialEntryType
  amountMinorUnits      Int
  currencyCode          String               @db.VarChar(3)
  description           String               @db.VarChar(500)
  category              String               @db.VarChar(100)
  source                FinancialEntrySource
  etsyShopId            BigInt?
  etsyReceiptId         BigInt?
  etsyTransactionId     BigInt?
  etsyLedgerEntryId     BigInt?
  externalReference     String?              @db.VarChar(191)
  dedupeKey             String               @unique @db.VarChar(191)
  rawJson               Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  shop                  EtsyShop?            @relation(fields: [etsyShopId], references: [etsyShopId], onDelete: SetNull)
  etsyReceipt           EtsyReceipt?         @relation("ReceiptFinancialEntry")
  etsyLedgerEntry       EtsyPaymentLedgerEntry? @relation("LedgerFinancialEntry")

  @@index([entryDate])
  @@index([type, entryDate])
  @@index([source, entryDate])
  @@index([category, entryDate])
  @@index([etsyShopId])
  @@map("financial_entries")
}

model EtsyReceipt {
  id                    Int             @id @default(autoincrement())
  etsyShopId            BigInt
  etsyReceiptId         BigInt
  status                String?         @db.VarChar(50)
  isPaid                Boolean?
  isCanceled            Boolean?
  grandTotalAmount      Int?
  grandTotalDivisor     Int?
  currencyCode          String?         @db.VarChar(3)
  createdAtEtsy         DateTime?
  updatedAtEtsy         DateTime?
  rawJson               Json
  financialEntryId      Int?            @unique
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  shop                  EtsyShop        @relation(fields: [etsyShopId], references: [etsyShopId], onDelete: Cascade)
  financialEntry        FinancialEntry? @relation("ReceiptFinancialEntry", fields: [financialEntryId], references: [id], onDelete: SetNull)
  transactions          EtsyTransaction[]

  @@unique([etsyShopId, etsyReceiptId], map: "etsy_receipts_shop_receipt_key")
  @@index([createdAtEtsy])
  @@index([updatedAtEtsy])
  @@map("etsy_receipts")
}

model EtsyTransaction {
  id                    Int          @id @default(autoincrement())
  receiptId             Int
  etsyShopId            BigInt
  etsyReceiptId         BigInt
  etsyTransactionId     BigInt
  etsyListingId         BigInt?
  title                 String?      @db.VarChar(500)
  quantity              Int?
  priceAmount           Int?
  priceDivisor          Int?
  currencyCode          String?      @db.VarChar(3)
  createdAtEtsy         DateTime?
  paidAtEtsy            DateTime?
  rawJson               Json
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  receipt               EtsyReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  shop                  EtsyShop     @relation(fields: [etsyShopId], references: [etsyShopId], onDelete: Cascade)

  @@unique([etsyShopId, etsyTransactionId], map: "etsy_transactions_shop_transaction_key")
  @@index([receiptId])
  @@index([etsyReceiptId])
  @@index([createdAtEtsy])
  @@map("etsy_transactions")
}

model EtsyPaymentLedgerEntry {
  id                    Int             @id @default(autoincrement())
  etsyShopId            BigInt
  etsyLedgerEntryId     BigInt
  etsyLedgerId          BigInt?
  sequenceNumber        Int?
  amountMinorUnits      Int?
  currencyCode          String?         @db.VarChar(3)
  balanceMinorUnits     Int?
  description           String?         @db.VarChar(500)
  ledgerType            String?         @db.VarChar(100)
  referenceType         String?         @db.VarChar(100)
  referenceId           String?         @db.VarChar(191)
  parentEntryId         BigInt?
  createdAtEtsy         DateTime?
  rawJson               Json
  financialEntryId      Int?            @unique
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  shop                  EtsyShop        @relation(fields: [etsyShopId], references: [etsyShopId], onDelete: Cascade, map: "etsy_payment_ledger_entries_shop_fkey")
  financialEntry        FinancialEntry? @relation("LedgerFinancialEntry", fields: [financialEntryId], references: [id], onDelete: SetNull, map: "etsy_payment_ledger_entries_financial_fkey")

  @@unique([etsyShopId, etsyLedgerEntryId], map: "etsy_ledger_entries_shop_entry_key")
  @@index([createdAtEtsy])
  @@index([ledgerType])
  @@map("etsy_payment_ledger_entries")
}

model EtsyAccountingSyncState {
  id                         Int                       @id @default(autoincrement())
  etsyShopId                 BigInt                    @unique
  fullSyncCompleted          Boolean                   @default(false)
  lastSuccessfulReceiptSyncAt DateTime?
  lastSuccessfulLedgerSyncAt DateTime?
  overlapSeconds             Int                       @default(172800)
  status                     EtsyAccountingSyncStatus @default(IDLE)
  syncStartedAt              DateTime?
  lastSuccessfulSyncAt       DateTime?
  lastError                  String?                   @db.Text
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  shop                       EtsyShop                  @relation(fields: [etsyShopId], references: [etsyShopId], onDelete: Cascade, map: "etsy_accounting_sync_states_shop_fkey")

  @@index([status])
  @@map("etsy_accounting_sync_states")
}

model EtsyShopSection {
  id                  Int                  @id @default(autoincrement())
  shopId              Int?
  etsyShopId          BigInt?
  etsyShopSectionId   String?
  title               String
  roomTheme           String?              @db.VarChar(200)
  rank                Int?
  activeListingCount  Int?
  rawJson             Json?
  downloadedAt        DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  numberOfDownloads   Int                  @default(1)
  includeAllDownloads Boolean              @default(false)
  sourceSectionId     Int?
  shop                EtsyShop?            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subSections         EtsyShopSubSection[]
  sourceListings      EtsyListing[]        @relation("ListingSourceSection")
  pinterestCampaigns  PinterestCampaign[]

  @@unique([shopId, title])
  @@unique([shopId, etsyShopSectionId])
  @@unique([etsyShopId, etsyShopSectionId])
  @@index([shopId])
  @@index([etsyShopId])
  @@map("etsy_shop_sections")
}

model PinterestConnection {
  id                      Int       @id @default(1)
  accountId               String?
  username                String?
  accessTokenEncrypted    String    @db.Text
  refreshTokenEncrypted   String?   @db.Text
  accessTokenExpiresAt    DateTime?
  refreshTokenExpiresAt   DateTime?
  scopes                  Json
  environment             String    @default("production") @db.VarChar(20)
  connectedAt             DateTime  @default(now())
  lastSuccessfulApiTestAt DateTime?
  lastError               String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("pinterest_connections")
}

model PinterestBoard {
  id               Int            @id @default(autoincrement())
  pinterestBoardId String         @unique
  name             String
  description      String?        @db.Text
  privacy          String         @default("PUBLIC") @db.VarChar(30)
  pinCount         Int?
  lastSyncedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  pins             PinterestPin[]

  @@map("pinterest_boards")
}

model PinterestCampaign {
  id              Int              @id @default(autoincrement())
  name            String
  sourceSectionId Int?
  status          String           @default("DRAFT") @db.VarChar(20)
  startDate       DateTime
  endDate         DateTime?
  pinsPerDay      Int              @default(1)
  configuration   Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sourceSection   EtsyShopSection? @relation(fields: [sourceSectionId], references: [id], onDelete: SetNull)
  pins            PinterestPin[]

  @@index([sourceSectionId])
  @@index([status])
  @@map("pinterest_campaigns")
}

model PinterestPin {
  id             Int                @id @default(autoincrement())
  listingId      Int
  imageId        Int?
  boardId        Int
  campaignId     Int?
  pinterestPinId String?            @unique
  creativeType   String             @default("STANDARD") @db.VarChar(20)
  title          String             @db.VarChar(100)
  description    String             @db.Text
  destinationUrl String?            @db.Text
  status         String             @default("DRAFT") @db.VarChar(20)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  error          String?            @db.Text
  retryCount     Int                @default(0)
  publicationKey String             @unique @db.VarChar(191)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  listing        EtsyListing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  image          EtsyListingImage?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  board          PinterestBoard     @relation(fields: [boardId], references: [id], onDelete: Restrict)
  campaign       PinterestCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([imageId])
  @@index([boardId])
  @@index([campaignId])
  @@index([status, scheduledAt])
  @@map("pinterest_pins")
}

model PinterestAnalyticsSnapshot {
  id             Int      @id @default(autoincrement())
  rangeStart     DateTime
  rangeEnd       DateTime
  accountMetrics Json
  pinMetrics     Json
  fetchedAt      DateTime @default(now())

  @@index([rangeStart, rangeEnd])
  @@map("pinterest_analytics_snapshots")
}

model EtsyShopSubSection {
  id                  Int             @id @default(autoincrement())
  shopSectionId       Int
  name                String
  numberOfDownloads   Int?
  includeAllDownloads Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  shopSection         EtsyShopSection @relation(fields: [shopSectionId], references: [id], onDelete: Cascade)
  listings            EtsyListing[]

  @@unique([shopSectionId, name])
  @@index([shopSectionId])
  @@map("etsy_shop_sub_sections")
}

model EtsyListingTag {
  id        Int         @id @default(autoincrement())
  listingId Int
  tag       String
  position  Int?
  listing   EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, tag])
  @@map("etsy_listing_tags")
}

model EtsyListingMaterial {
  id        Int         @id @default(autoincrement())
  listingId Int
  material  String
  position  Int?
  listing   EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, material])
  @@map("etsy_listing_materials")
}

model EtsyListingImage {
  id               Int            @id @default(autoincrement())
  listingId        Int
  etsyImageId      String?
  etsyDownloadImageId String?
  localFileName    String?
  originalFileName String?
  rank             Int?
  url75x75         String?        @db.Text
  url170x135       String?        @db.Text
  url570xN         String?        @db.Text
  urlFullxFull     String?        @db.Text
  fullHeight       Int?
  fullWidth        Int?
  listing          EtsyListing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  pinterestPins    PinterestPin[]

  @@unique([listingId, etsyImageId])
  @@unique([listingId, etsyDownloadImageId])
  @@map("etsy_listing_images")
}

model EtsyListingFile {
  id                Int         @id @default(autoincrement())
  listingId         Int
  etsyListingFileId String?
  localFileName     String?
  originalFileName  String?
  rank              Int?
  filename          String?
  filesize          String?
  sizeBytes         Int?
  widthPixels       Int?
  heightPixels      Int?
  jpegQuality       Int?
  zipNumber         Int?
  filetype          String?
  createTimestamp   Int?
  createdTimestamp  Int?
  rawJson           Json
  downloadedAt      DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  listing           EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("etsy_listing_files")
}

model EtsyListingZip {
  id                Int         @id @default(autoincrement())
  listingId         Int
  zipNumber         Int
  fileName          String
  sizeBytes         Int
  etsyListingFileId String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  listing           EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, zipNumber])
  @@map("etsy_listing_zips")
}

model EtsyListingStyle {
  id        Int         @id @default(autoincrement())
  listingId Int
  style     String
  position  Int?
  listing   EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, style])
  @@map("etsy_listing_styles")
}

model EtsyListingVideo {
  id               Int         @id @default(autoincrement())
  listingId        Int
  localFileName    String?
  originalFileName String?
  etsyVideoId      String?
  rank             Int?
  listing          EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, etsyVideoId])
  @@map("etsy_listing_videos")
}

model EtsyListingTranslation {
  id          Int         @id @default(autoincrement())
  listingId   Int
  language    String
  title       String?
  description String?     @db.Text
  listing     EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, language])
  @@map("etsy_listing_translations")
}

model EtsyListingInventory {
  id        Int         @id @default(autoincrement())
  listingId Int
  name      String
  value     String?
  sku       String?
  price     Float?
  quantity  Int?
  listing   EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("etsy_listing_inventory")
}

model EtsyListingPersonalization {
  id           Int         @id @default(autoincrement())
  listingId    Int
  instructions String      @db.Text
  isRequired   Boolean     @default(false)
  charCountMax Int?
  listing      EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("etsy_listing_personalizations")
}

model EtsyListingBuyerPrice {
  id           Int         @id @default(autoincrement())
  listingId    Int
  amount       Int
  divisor      Int         @default(100)
  currencyCode String      @default("GBP")
  note         String?
  listing      EtsyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("etsy_listing_buyer_prices")
}
